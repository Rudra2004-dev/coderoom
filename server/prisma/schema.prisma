generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  interviewer
  candidate
}

enum RoomStatus {
  waiting
  live
  ended
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  hostedRooms  Room[]   @relation("Interviewer")
  joinedRooms  Room[]   @relation("Candidate")
}

model Room {
  id            String     @id @default(uuid())
  slug          String     @unique
  interviewerId String
  candidateId   String?
  language      String     @default("python")
  status        RoomStatus @default(waiting)
  createdAt     DateTime   @default(now())
  endedAt       DateTime?
  interviewer   User       @relation("Interviewer", fields: [interviewerId], references: [id])
  candidate     User?      @relation("Candidate", fields: [candidateId], references: [id])
}