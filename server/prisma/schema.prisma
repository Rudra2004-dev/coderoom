generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  interviewer
  candidate
}

enum RoomStatus {
  waiting
  live
  ended
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  hostedRooms  Room[]   @relation("Interviewer")
  joinedRooms  Room[]   @relation("Candidate")
}

model Room {
  id            String       @id @default(uuid())
  slug          String       @unique
  interviewerId String
  candidateId   String?
  questionId    String?
  language      String       @default("python")
  status        RoomStatus   @default(waiting)
  createdAt     DateTime     @default(now())
  endedAt       DateTime?
  interviewer   User         @relation("Interviewer", fields: [interviewerId], references: [id])
  candidate     User?        @relation("Candidate", fields: [candidateId], references: [id])
  question      Question?    @relation(fields: [questionId], references: [id])
  submissions   Submission[]
  finalCode     String?
  finalLanguage String?
  scorecard     Scorecard?
}


model Question {
  id           String     @id @default(uuid())
  slug         String     @unique
  position     Int        @default(0)
  title        String
  difficulty   String
  description  String
  inputFormat  String
  outputFormat String
  createdAt    DateTime   @default(now())
  testCases    TestCase[]
  rooms        Room[]
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  order          Int      @default(0)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  language    String
  code        String
  results     Json
  passedCount Int
  totalCount  Int
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id])
}


model Scorecard {
  id          String   @id @default(uuid())
  roomId      String   @unique
  correctness Int
  codeQuality Int
  efficiency  Int
  model       String
  details     Json
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id])
}